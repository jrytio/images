# The upstream base, pinned. Bump both together -- the build verifies the
# checksum before it customizes anything.
UPSTREAM_URL="https://cloud-images.ubuntu.com/minimal/releases/noble/release/ubuntu-24.04-minimal-cloudimg-amd64.img"
UPSTREAM_SHA256="d2ed9bebd51635f75b48ef0b27a58f03e27a32a2a6544c507d117d323eeac714"

# Every package baked in, and why. Keep this list short: what is baked here
# is frozen until the next build, whereas anything installed at node boot
# tracks the archive. These two earn it because installing them at boot is
# what breaks (see README).
#   qemu-guest-agent -- CAPMOX gates machine readiness on the agent
#                       answering `cloud-init status`.
#   iptables         -- RKE2 requirement the minimal image lacks; without
#                       the binary the CNI portmap plugin fails hostPort
#                       pods after IP allocation.
PACKAGES="qemu-guest-agent iptables"

# The RKE2 canal (CNI) images baked into agent/images/ (see build.sh for
# the bootstrap deadlock this breaks). Track infra's downstream RKE2
# version (stacks/23-capi); bump all four lines together -- each sha256
# is the matching line from the release's sha256sum-amd64.txt, except
# SHA256SUM_FILE_SHA256 which is the sha256 OF that file itself (it is
# what CABPR's airGappedChecksum verifies on the node; recompute with
# `sha256sum sha256sum-amd64.txt`).
#
# Unlike the canal tarball, RKE2-version skew here is NOT degraded --
# it is load-bearing: with airGapped install the node runs whatever
# /opt/rke2-artifacts holds, so infra's airGappedChecksum pin exists to
# fail a mismatched node loudly at install time instead of joining a
# wrong-versioned node quietly. Bump this repo and the infra pins in
# lockstep with any RKE2 upgrade, image first.
RKE2_VERSION="v1.36.3+rke2r1"
CANAL_IMAGES_SHA256="9e89572eb2a5958b456dc1ca418bdbdbd694a176dd2cf41e6df55fe0488156ba"
RKE2_TARBALL_SHA256="5bbc6315131af7f435385d0ed63f14788ef2a858ac482f8b9146cf3a1a1582d3"
SHA256SUM_FILE_SHA256="cdca77b9714aae5cf2052c1b01142ef75e609e0165ca8ad63b4c2ab034eb5ce3"

OUT_NAME="ubuntu-24.04-minimal-k8s-amd64.img"
